# LiveSync CLI 默认从公开 fork 构建，启用点文件同步支持。
# 生产环境可改为已验证的镜像 tag 或 digest。
LIVESYNC_IMAGE=livesync-cli-fork:local
# 可改为本地 fork 目录，或固定到 fork 的 Git commit：
# LIVESYNC_BUILD_CONTEXT=/path/to/obsidian-livesync
# LIVESYNC_BUILD_CONTEXT=https://github.com/Skyxim/obsidian-livesync.git#<COMMIT>

# CouchDB 连接信息。URI 必须是容器可访问的地址，容器内的 localhost 不是宿主机。
COUCHDB_URI=https://couchdb.example.com
COUCHDB_USER=<COUCHDB_USER>
COUCHDB_PASSWORD=<COUCHDB_PASSWORD>
COUCHDB_DBNAME=obsidian-livesync

# LiveSync 加密设置。启用加密时必须设置非空口令。
LIVESYNC_ENCRYPT=true
LIVESYNC_PASSPHRASE=<LIVESYNC_PASSPHRASE>

# 默认使用 CouchDB 事件流；只有设置为正整数时才启用轮询回退。
# 例如：LIVESYNC_INTERVAL_SECONDS=60
LIVESYNC_INTERVAL_SECONDS=

# 与 Obsidian 客户端的 Use Request API 设置保持一致。
LIVESYNC_USE_REQUEST_API=false

# 是否同步 .obsidian、.trash 等隐藏文件和目录。
# 启用前请确认远端配置和备份仓库允许保存这些内容。
LIVESYNC_SYNC_INTERNAL_FILES=false

# 以下参数必须与已有远端 LiveSync 配置保持一致。
# 新建远端可按需使用默认值；接入已有远端前应先确认其配置。
LIVESYNC_USE_PATH_OBFUSCATION=false
LIVESYNC_ENCRYPT_INTERNAL_METADATA=false
LIVESYNC_USE_PLUGIN_SYNC_V2=false
LIVESYNC_CUSTOM_CHUNK_SIZE=0
LIVESYNC_E2EE_ALGORITHM=v2

# Git 冷备设置。
BACKUP_INTERVAL_SECONDS=3600
BACKUP_GIT_BRANCH=main
BACKUP_AUTHOR_NAME=LiveSync Git Backup
BACKUP_AUTHOR_EMAIL=backup@example.invalid

# 可选：设置远程 Git 仓库后，每次有新提交都会推送。
# 不要把 token、密码或私钥写入 URL；建议使用 compose.ssh.yaml。
BACKUP_REMOTE=
BACKUP_SSH_KEY_PATH=./secrets/backup_ssh_key
BACKUP_SSH_KNOWN_HOSTS_PATH=./secrets/known_hosts
