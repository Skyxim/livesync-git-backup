# LiveSync CLI 镜像。edge 跟随上游发布；生产环境可改为固定 tag 或 digest。
LIVESYNC_IMAGE=ghcr.io/vrtmrz/livesync-cli:edge

# CouchDB 连接信息。URI 必须是容器可访问的地址，容器内的 localhost 不是宿主机。
COUCHDB_URI=https://couchdb.example.com
COUCHDB_USER=<COUCHDB_USER>
COUCHDB_PASSWORD=<COUCHDB_PASSWORD>
COUCHDB_DBNAME=obsidian-livesync

# LiveSync 加密设置。启用加密时必须设置非空口令。
LIVESYNC_ENCRYPT=true
LIVESYNC_PASSPHRASE=<LIVESYNC_PASSPHRASE>

# Git 冷备设置。
BACKUP_INTERVAL_SECONDS=3600
BACKUP_GIT_BRANCH=main
BACKUP_AUTHOR_NAME=LiveSync Git Backup
BACKUP_AUTHOR_EMAIL=backup@example.invalid

# 可选：设置远程 Git 仓库后，每次有新提交都会推送。
# 不要把 token、密码或私钥写入 URL；建议使用 compose.ssh.yaml。
BACKUP_REMOTE=
BACKUP_SSH_KEY_PATH=./secrets/backup_ssh_key
BACKUP_SSH_KNOWN_HOSTS_PATH=./secrets/known_hosts
